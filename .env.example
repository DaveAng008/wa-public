# ─────────────────────────────────────────────────────────────────────────────
#  WhatsApp CRM · 部署环境变量模板（白标）
#  用法：复制成 .env（本地）／或把下面内容整段粘进 Coolify 的 Environment Variables
#  ⚠️ 所有值都必须由部署者自己生成，仓库里不留任何真实密钥
#  ⚠️ 生成后 AUTH_SECRET / EVOLUTION_API_KEY / ENCRYPTION_KEY 不要随意更改
# ─────────────────────────────────────────────────────────────────────────────

# ── 品牌（白标）：改这两个值即可替换全站产品名，无需改代码 ──────────────────
# 注意：NEXT_PUBLIC_ 变量在构建时写入前端，改完要重新部署
NEXT_PUBLIC_APP_NAME=WhatsApp CRM
NEXT_PUBLIC_APP_NAME_SUFFIX=Pro

# 你的网站公网地址（Coolify 里配好域名后填这里）
APP_URL=https://your-domain.example.com

# 业务数据库（MySQL 8）。注意必须带 charset=utf8mb4，否则中文/emoji 会出错
DATABASE_URL=mysql://user:password@host:3306/dbname?charset=utf8mb4

# 登录会话密钥 —— 生成：openssl rand -base64 48
AUTH_SECRET=

# Evolution API 全局 Key（网站与 Evolution 共用同一个值）
# 生成：openssl rand -hex 32
EVOLUTION_API_KEY=

# Evolution 自带 Postgres 的密码 —— 生成：openssl rand -hex 16
EVO_DB_PASSWORD=

# Evolution 回调本网站时携带的凭证 —— 生成：openssl rand -hex 32
WEBHOOK_TOKEN=

# 数据库结构初始化接口 /api/patch-db?token=xxx 的令牌 —— 生成：openssl rand -hex 32
DB_PATCH_TOKEN=

# 内部令牌：定时任务(cron)与网站内部互调使用 —— 生成：openssl rand -hex 32
# 未配置时，所有 cron / 内部调用通道一律关闭（fail closed）
CRON_TOKEN=

# 服务端访问自己的固定基址（内部调用用，避免信任请求的 Host 头）
# 单机 docker-compose 部署可留空（会自动回退到 http://127.0.0.1:3000）
INTERNAL_BASE_URL=

# 首次初始化数据库时创建的管理员（不配置则不创建任何账号 —— 避免默认密码风险）
# 密码至少 8 位；创建后请立即登录修改
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=

# 实例 token 的字段级加密密钥（实现「多实例 Token 隔离」时使用）
# 生成：openssl rand -base64 32
ENCRYPTION_KEY=

# 时区（马来西亚用 Asia/Kuala_Lumpur）
TZ=Asia/Kuala_Lumpur

# web 服务在本机发布的端口（Coolify 会用自己的反代接管，一般不用改）
WEB_PORT=3000

# ── 仅当启用 compose 里注释掉的 MySQL 服务时才需要 ──────────────────────────
# MYSQL_ROOT_PASSWORD=
# MYSQL_PASSWORD=
